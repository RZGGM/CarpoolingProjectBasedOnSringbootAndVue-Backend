<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gzasc.onlinecarhailing.Mapper.PassengerMapper">
    <insert id="insert" >
        insert into passenger(phone, gender, statue, name, account, account_id, update_time)
        values (#{phone},#{gender},#{state},#{name},#{account},#{accountId},#{updateTime})
    </insert>
    <update id="update" keyProperty="passengerId" useGeneratedKeys="true">

    </update>

    <delete id="deleteById">
        delete from passenger where id = #{id}
    </delete>
    <delete id="deleteByIds">
        delete from passenger where id in
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </delete>
    <select id="selectById" resultType="com.gzasc.onlinecarhailing.pojo.Passenger">
        select * from passenger where id = #{id}
    </select>
    <select id="selectAll" resultType="com.gzasc.onlinecarhailing.pojo.Passenger">
        select * from passenger
    </select>
</mapper>