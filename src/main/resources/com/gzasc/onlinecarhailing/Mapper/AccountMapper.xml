<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gzasc.onlinecarhailing.Mapper.AccountMapper">


    <insert id="insertAccount" keyProperty="id" useGeneratedKeys="true">
        insert into account(account, password, driver_id, passenger_id, manager_id, phone)
        values (#{account}, #{password}, #{driverId}, #{passengerId}, #{managerId}, #{phone})
    </insert>

    <update id="updateAccount" useGeneratedKeys="true" keyProperty="id">
        update account
        <set>
            <if test="driverId != null">
                driver_id = #{driverId},
            </if>
            <if test="passengerId != null">
                passenger_id = #{passengerId},
            </if>
            <if test="password != null">
                password = #{password},
            </if>
            <if test="phone != null">
                phone = #{phone},
            </if>
        </set>
        where id = #{id}
    </update>
    <update id="updateAccountsPassengerIdToNullByAccountIds">
        update account
        <set>

            passenger_id = null

        </set>
        where id in
        <foreach collection="accountIds" item="id" separator="," open="(" close=")">

            #{id}

        </foreach>
    </update>

    <delete id="deleteAccount">
        delete
        from account
        where id = #{id}
    </delete>
    <delete id="deleteAccountsById">

        delete from account where id in
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>

    </delete>
    <!--    表里面没有区分帐号类型的属性，是靠有无对应身份的id来判断的。-->
    <!--    <resultMap id="accountMap" type="com.gzasc.onlinecarhailing.pojo.Account">-->

    <!--        <result column=""></result>-->

    <!--    </resultMap>-->

    <select id="selectByAccount" resultType="com.gzasc.onlinecarhailing.pojo.Account">
        select *
        from account
        where account = #{account}
    </select>
    <select id="selectAll" resultType="com.gzasc.onlinecarhailing.pojo.Account">
        select *
        from account
    </select>
    <select id="selectById" resultType="com.gzasc.onlinecarhailing.pojo.Account">
        select * from account where id in
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </select>
    <select id="selectByPhoneAndAccount" resultType="com.gzasc.onlinecarhailing.pojo.Account">

        select *
        from account
        where phone = #{phone}
          and account = #{account}

    </select>
    <select id="selectByPhone" resultType="com.gzasc.onlinecarhailing.pojo.Account">

        select *
        from account
        where phone = #{phone}

    </select>
</mapper>