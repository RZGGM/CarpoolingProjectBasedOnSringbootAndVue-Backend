<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gzasc.onlinecarhailing.Mapper.AccountMapper">


    <insert id="insertAccount" keyProperty="id" useGeneratedKeys="true" >
        insert into account(account, password, driver_id, passenger_id, manager_id)
        values (#{account}, #{password}, #{driverId}, #{passengerId}, #{managerId})
    </insert>
    <update id="updateAccount">
        update account
        <set>
            <if test="driverId != null">
                driver_id = #{driverId}
            </if>
            <if test="passengerId != null">
                passenger_id = #{passengerId}
            </if>
            <if test="password != null">
                password = #{password}
            </if>
        </set>
        where id = #{id}
    </update>

    <delete id="deleteAccount">
        delete
        from account
        where id = #{id}
    </delete>
    <select id="selectByAccount" resultType="com.gzasc.onlinecarhailing.pojo.Account">
        select *
        from account
        where account = #{account}
    </select>
    <select id="selectAll" resultType="com.gzasc.onlinecarhailing.pojo.Account">
        select *
        from account
    </select>
</mapper>