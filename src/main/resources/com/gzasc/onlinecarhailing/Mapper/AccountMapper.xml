            account(account,password,driver_id, passenger_id, manager_id)
        values (
            #{account},#{password},#{driverId},#{passenerId},#{managerId}
            )
    </insert>
    <update id="updateAccount">

    </update>
    <delete id="deleteAccount">
        delete from account where id = #{id}
    </delete>
    <select id="selectByAccount" resultType="com.gzasc.onlinecarhailing.pojo.Account">

    </select>
    <select id="selectAll" resultType="com.gzasc.onlinecarhailing.pojo.Account">
        select * from account
    </select>
</mapper>