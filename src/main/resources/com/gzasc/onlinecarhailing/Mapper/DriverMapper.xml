<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gzasc.onlinecarhailing.Mapper.DriverMapper">


    <insert id="insert" useGeneratedKeys="true" keyProperty="driverId" >
        insert into driver(driver_birthday, driver_nation, driver_address, driver_license, update_time, phone, gender,
                           state, name, account_id, account)
        values (#{driverBirthday},#{driverNation},#{driverAddress},#{driverLicense},#{updateTime},#{phone},
                #{gender},#{state},#{name},#{accountId},#{account})
    </insert>
    <update id="update">

    </update>

    <delete id="deleteById">
        delete from driver where id = #{id}
    </delete>

    <resultMap id="driverMap" type="com.gzasc.onlinecarhailing.pojo.Driver">
        <result  column="id" property="driverId" />
    </resultMap>

    <select id="selectById" resultType="com.gzasc.onlinecarhailing.pojo.Driver"  resultMap="driverMap">
        select * from driver where id = #{id}
    </select>
    <select id="selectByDriverId" resultType="com.gzasc.onlinecarhailing.pojo.Driver" resultMap="driverMap">
        select * from driver where id = #{driverId}
    </select>
    <select id="selectAll" resultType="com.gzasc.onlinecarhailing.pojo.Driver">
        select * from driver
    </select>
</mapper>